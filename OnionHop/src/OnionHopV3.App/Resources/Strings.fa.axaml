  <x:String x:Key="Logs.ColumnMessage">پیام</x:String>
  <x:String x:Key="Logs.ColumnType">نوع</x:String>
  <x:String x:Key="Logs.ColumnAddress">نشانی</x:String>
  <x:String x:Key="Logs.ColumnDetails">جزئیات</x:String>
  <x:String x:Key="Logs.BridgeInUse">در حال استفاده</x:String>
  <x:String x:Key="Logs.CopyRow">کپی این پل</x:String>
  <x:String x:Key="Logs.EmptyTitle">هیچ رکورد گزارشی با نمای فعلی مطابقت ندارد</x:String>
  <x:String x:Key="Logs.EmptyDescription">تب دیگری امتحان کنید، متن جستجو را پاک کنید، یا منتظر فعالیت جدید محیط اجرا باشید.</x:String>
  <x:String x:Key="Logs.Summary">خلاصه</x:String>
  <x:String x:Key="Logs.TotalEntries">مجموع رکوردها</x:String>
  <x:String x:Key="Logs.ActiveSources">منابع فعال</x:String>
  <x:String x:Key="Logs.Pause">مکث</x:String>
  <x:String x:Key="Logs.AutoScroll">اسکرول خودکار</x:String>

  <!-- V3 Relays -->
  <x:String x:Key="Relays.Refresh">بروزرسانی</x:String>
  <x:String x:Key="Relays.Search">جستجوی نام مستعار، اثر انگشت، کشور، یا IP</x:String>
  <x:String x:Key="Relays.AllCountries">همه کشورها</x:String>
  <x:String x:Key="Relays.AllRoles">همه نقش‌ها</x:String>
  <x:String x:Key="Relays.AllFlags">همه پرچم‌ها</x:String>
  <x:String x:Key="Relays.AnyBandwidth">هر پهنای باند</x:String>
  <x:String x:Key="Relays.Warning">انتخاب دستی relay و خروجی می‌تواند ناشناسی را کاهش دهد.</x:String>
  <x:String x:Key="Relays.WarningHint">از ترجیحات دستی فقط زمانی استفاده کنید که مبادلات حریم خصوصی و مسیر بازیابی را درک می‌کنید.</x:String>
  <x:String x:Key="Relays.ColumnNickname">نام مستعار</x:String>
  <x:String x:Key="Relays.ColumnCountry">کشور</x:String>
  <x:String x:Key="Relays.ColumnRole">نقش</x:String>
  <x:String x:Key="Relays.ColumnBandwidth">پهنای باند</x:String>
  <x:String x:Key="Relays.ColumnUptime">مدت اجرا</x:String>
  <x:String x:Key="Relays.EmptyTitle">هیچ relay‌ای با فیلترهای فعلی مطابقت ندارد</x:String>
  <x:String x:Key="Relays.EmptyDescription">جستجو را گسترش دهید یا فیلترهای پهنای باند و پرچم را کاهش دهید.</x:String>
  <x:String x:Key="Relays.Details">relay انتخاب‌شده</x:String>
  <x:String x:Key="Relays.CopyFingerprint">کپی اثر انگشت</x:String>
  <x:String x:Key="Relays.SelectRelay">انتخاب یک relay</x:String>
  <x:String x:Key="Relays.SelectRelayHint">جزئیات relay، پرچم‌ها، و کنترل‌های خروجی آزمایشی اینجا ظاهر می‌شوند.</x:String>
  <x:String x:Key="Relays.FieldFingerprint">اثر انگشت</x:String>
  <x:String x:Key="Relays.FieldCountry">کشور</x:String>
  <x:String x:Key="Relays.FieldAddress">آدرس</x:String>
  <x:String x:Key="Relays.FieldPort">پورت OR</x:String>
  <x:String x:Key="Relays.FieldBandwidth">پهنای باند</x:String>
  <x:String x:Key="Relays.FieldUptime">مدت اجرا</x:String>
  <x:String x:Key="Relays.FieldAdded">اضافه‌شده</x:String>
  <x:String x:Key="Relays.FieldFlags">پرچم‌ها</x:String>
  <x:String x:Key="Relays.UseAsPreferredExit">استفاده به عنوان خروجی ترجیحی (آزمایشی)</x:String>
  <x:String x:Key="Relays.SelectExitRelayFirst">ابتدا یک relay خروجی انتخاب کنید</x:String>
  <x:String x:Key="Relays.UseAsPreferredGuard">استفاده به عنوان guard ترجیحی (آزمایشی)</x:String>
  <x:String x:Key="Relays.SelectGuardRelayFirst">ابتدا یک relay guard انتخاب کنید</x:String>
  <x:String x:Key="Relays.UseAsPreferredMiddle">استفاده به عنوان میانی ترجیحی (آزمایشی)</x:String>
  <x:String x:Key="Relays.SelectMiddleRelayFirst">ابتدا یک relay میانی انتخاب کنید</x:String>
  <x:String x:Key="Relays.PreferenceSaved">ترجیح {0} برای {1} ذخیره شد.</x:String>
  <x:String x:Key="Relays.Bandwidth1Mb">حداقل 1 MB/s</x:String>
  <x:String x:Key="Relays.Bandwidth10Mb">حداقل 10 MB/s</x:String>
  <x:String x:Key="Relays.Bandwidth50Mb">حداقل 50 MB/s</x:String>
  <x:String x:Key="Relays.RoleGuard">Guard</x:String>
  <x:String x:Key="Relays.RoleMiddle">میانی</x:String>
  <x:String x:Key="Relays.RoleExit">خروجی</x:String>

  <!-- V3 Status -->
  <x:String x:Key="Status.ProtectionSystem">مسیریابی سراسری سیستم فعال</x:String>
  <x:String x:Key="Status.ProtectionProxy">مسیریابی Proxy فعال</x:String>
  <x:String x:Key="Status.ProtectionOff">حفاظت غیرفعال</x:String>
  <x:String x:Key="Status.ProtectionOffDetail">ترافیک در حال حاضر از مسیر شبکه معمولی شما استفاده می‌کند.</x:String>
  <x:String x:Key="Status.EngineClassicDetail">محیط اجرای کلاسیک امروز فعال است.</x:String>
  <x:String x:Key="Status.EngineAutomaticDetail">حالت خودکار در حال حاضر به محیط اجرای کلاسیک تبدیل می‌شود.</x:String>
  <x:String x:Key="Status.UpdateChecksOff">بررسی بروزرسانی غیرفعال است</x:String>
  <x:String x:Key="Status.UpdateChecking">در حال بررسی بروزرسانی‌ها</x:String>
  <x:String x:Key="Status.UpdateUnknown">وضعیت بروزرسانی در دسترس نیست</x:String>
  <x:String x:Key="Status.UpdateAvailable">بروزرسانی در دسترس است: {0}</x:String>
  <x:String x:Key="Status.UpdateCurrent">به‌روز است</x:String>
  <!-- Routing rules and other strings that were English-only in every translation -->
  <x:String x:Key="Home.IpGeoCaveat">کشور نمایش داده شده از روی این IP تخمین زده می‌شود و ممکن است با خروجی انتخابی شما فرق کند. Tor همچنان از کشور خروجی‌ای که انتخاب کرده‌اید عبور می‌کند.</x:String>
  <x:String x:Key="Logs.TabBridges">پل فعلی</x:String>
  <x:String x:Key="Settings.EntryNodeBridgesNote">وقتی پل‌ها روشن هستند انتخاب گره ورودی در دسترس نیست: پل همان ورودی شما به Tor است.</x:String>
  <x:String x:Key="Settings.SplitTunnelingToggleHint">برنامه‌های انتخاب‌شده را از Tor عبور دهید و بقیه مستقیم وصل شوند. به حالت TUN/VPN نیاز دارد؛ این را روشن کنید تا از انتخابگر برنامه و گزینه‌های زیر استفاده کنید. تغییرات مسیریابی از اتصال بعدی اعمال می‌شوند. (کلید قطع فقط در حالت تونل کامل کار می‌کند، پس تا وقتی این روشن است در دسترس نیست.)</x:String>
  <x:String x:Key="Settings.RoutingRulesTitle">قوانین مسیریابی (حالت TUN/VPN)</x:String>
  <x:String x:Key="Settings.RoutingRulesHint">دامنه‌ها یا بازه‌های IP مشخص را مستقیم (بدون Tor) بفرستید یا مسدود کنید. فقط در حالت TUN/VPN اعمال می‌شود. در هر خط یک مورد؛ خط‌هایی که با # شروع شوند نادیده گرفته می‌شوند. دامنه‌ها شامل همه زیردامنه‌ها می‌شوند؛ بازه‌های IP با نشانه‌گذاری CIDR (مثلاً 10.0.0.0/8).</x:String>
  <x:String x:Key="Settings.RoutingBypass">دور زدن Tor (مستقیم)</x:String>
  <x:String x:Key="Settings.RoutingBypassHint">این مقصدها با IP واقعی شما خارج می‌شوند، نه از Tor. برای سایت‌های محلی یا داخلی که روی Tor کار نمی‌کنند مفید است.</x:String>
  <x:String x:Key="Settings.RoutingBlock">مسدود کردن</x:String>
  <x:String x:Key="Settings.RoutingBlockHint">این مقصدها کاملاً مسدود می‌شوند. برای دامنه‌های تبلیغاتی یا ردیاب مفید است.</x:String>
  <x:String x:Key="Settings.CountryRoutingTitle">مسیریابی بر اساس کشور (حالت TUN/VPN)</x:String>
  <x:String x:Key="Settings.CountryRoutingHint">کل کشورها را بر اساس IP و با فهرست‌های geoip که خودکار به‌روز می‌شوند، مستقیم بفرستید یا مسدود کنید. فقط در حالت TUN/VPN اعمال می‌شود. از کدهای کشور ISO استفاده کنید (مثلاً ir، ru، de)، در هر خط یکی یا جدا شده با ویرگول. فهرست‌ها در پس‌زمینه خودکار دانلود و به‌روز می‌شوند.</x:String>
  <x:String x:Key="Settings.CountryBypass">این کشورها مستقیم (دور زدن Tor)</x:String>
  <x:String x:Key="Settings.CountryBypassHint">ترافیک به IPهای این کشورها با IP واقعی شما خارج می‌شود، نه از Tor. برای سایت‌های داخلی که روی Tor کار نمی‌کنند مفید است.</x:String>
  <x:String x:Key="Settings.CountryBlock">مسدود کردن این کشورها</x:String>
  <x:String x:Key="Settings.CountryBlockHint">ترافیک به IPهای این کشورها کاملاً مسدود می‌شود.</x:String>
  <x:String x:Key="Settings.SiteRoutingTitle">مسیریابی بر اساس دسته دامنه (حالت TUN/VPN)</x:String>
  <x:String x:Key="Settings.SiteRoutingHint">کل دسته‌های دامنه را با فهرست‌های geosite که خودکار به‌روز می‌شوند، مستقیم بفرستید یا مسدود کنید (مثلاً category-ads-all برای مسدود کردن تبلیغات و ردیاب‌ها، یا دسته کشوری مثل ir برای مستقیم نگه‌داشتن سایت‌های آن). فقط در حالت TUN/VPN اعمال می‌شود. در هر خط یک دسته یا جدا شده با ویرگول. فهرست‌ها در پس‌زمینه خودکار دانلود و به‌روز می‌شوند.</x:String>
  <x:String x:Key="Settings.SiteBypass">این دسته‌ها مستقیم (دور زدن Tor)</x:String>
  <x:String x:Key="Settings.SiteBypassHint">دامنه‌های این دسته‌ها با IP واقعی شما خارج می‌شوند، نه از Tor. برای سایت‌های داخلی که روی Tor کار نمی‌کنند مفید است.</x:String>
  <x:String x:Key="Settings.SiteBlock">مسدود کردن این دسته‌ها</x:String>
  <x:String x:Key="Settings.SiteBlockHint">دامنه‌های این دسته‌ها کاملاً مسدود می‌شوند. category-ads-all برای مسدود کردن تبلیغات و ردیاب‌ها انتخاب خوبی است.</x:String>
</ResourceDictionary>
