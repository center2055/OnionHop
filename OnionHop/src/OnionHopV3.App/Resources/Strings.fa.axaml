  <x:String x:Key="BridgeType.Custom">سفارشی</x:String>
  <x:String x:Key="BridgeSource.Auto">خودکار (collector، سرویس پل، سپس آفلاین)</x:String>
  <x:String x:Key="BridgeSource.OnlineOnly">فقط سرویس پل Tor</x:String>
  <x:String x:Key="BridgeSource.OfflineOnly">فقط آفلاین</x:String>
  <x:String x:Key="BridgeSource.CollectorOnly">فقط collector OnionHop</x:String>
  <x:String x:Key="BridgeSource.Custom">فهرست سفارشی (از تنظیمات)</x:String>
  <x:String x:Key="ProxyScope.System">پروکسی سیستم (همه برنامه‌ها)</x:String>
  <x:String x:Key="ProxyScope.SystemSocks">پروکسی سیستم (SOCKS مرورگر/.onion)</x:String>
  <x:String x:Key="ProxyScope.LocalOnly">فقط پروکسی محلی (برنامه‌های دستی)</x:String>
  <x:String x:Key="TunStack.Mixed">ترکیبی (توصیه‌شده)</x:String>
  <x:String x:Key="TunStack.System">سیستم</x:String>
