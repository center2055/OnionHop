  <!-- Bridge Scanner -->
  <x:String x:Key="Scanner.Title">اسکنر Bridge</x:String>
  <x:String x:Key="Scanner.Subtitle">با TCP-ping پل‌ها را آزمایش کنید تا پل‌های قابل دسترس از منطقه خود را بیابید. سبز = قابل دسترس، زرد = کند، قرمز = مسدود/غیر قابل دسترس. موارد کارآمد را صادر کنید یا به عنوان پل‌های سفارشی اعمال کنید.</x:String>
  <x:String x:Key="Scanner.Category">دسته‌بندی</x:String>
  <x:String x:Key="Scanner.Transport">پروتکل انتقال</x:String>
  <x:String x:Key="Scanner.IpVersion">IP</x:String>
  <x:String x:Key="Scanner.Workers">کارگران</x:String>
  <x:String x:Key="Scanner.Timeout">وقفه (ثانیه)</x:String>
  <x:String x:Key="Scanner.CustomSource">لیست سفارشی</x:String>
  <x:String x:Key="Scanner.CustomSourceHint">به جای لیست collector، خطوط پل وارد شده توسط خودتان را اسکن کنید.</x:String>
  <x:String x:Key="Scanner.CustomWatermark">خطوط پل را اینجا وارد کنید، هر خط یک پل (مثال: obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0)</x:String>
  <x:String x:Key="Scanner.Start">شروع اسکن</x:String>
  <x:String x:Key="Scanner.Stop">توقف</x:String>
  <x:String x:Key="Scanner.Export">صادر کردن موارد کارآمد</x:String>
  <x:String x:Key="Scanner.ApplyAsCustom">استفاده از موارد کارآمد به عنوان پل</x:String>
  <x:String x:Key="Scanner.ColType">نوع پل</x:String>
  <x:String x:Key="Scanner.ColHost">میزبان</x:String>
  <x:String x:Key="Scanner.ColPort">پورت</x:String>
  <x:String x:Key="Scanner.ColPing">Ping (میلی‌ثانیه)</x:String>
  <x:String x:Key="Scanner.ColStatus">وضعیت</x:String>
  <x:String x:Key="Scanner.EmptyTitle">هنوز نتیجه اسکنی وجود ندارد</x:String>
  <x:String x:Key="Scanner.EmptyDescription">یک دسته‌بندی/پروتکل انتخاب کنید و شروع اسکن را بزنید، یا یک لیست سفارشی وارد کنید.</x:String>
  <x:String x:Key="Scanner.TabBridge">اسکنر پل</x:String>
  <x:String x:Key="Scanner.TabSni">اسکنر SNI</x:String>
  <x:String x:Key="Scanner.TabSaved">ذخیره‌شده</x:String>
  <x:String x:Key="Scanner.SaveToLibrary">ذخیره در کتابخانه</x:String>
  <x:String x:Key="Scanner.LoadBridges">بارگذاری پل‌ها</x:String>
  <x:String x:Key="Scanner.ImportFile">درون‌ریزی پرونده</x:String>
  <x:String x:Key="Sni.Title">اسکنر SNI</x:String>
  <x:String x:Key="Sni.Subtitle">میزبان‌های SNI/فرانت که در شبکه شما کار می‌کنند را پیدا می‌کند. حالت دامنه فهرستی از دامنه‌ها را آزمایش می‌کند؛ حالت محدوده یک SNI را در یک بازه IPv4 آزمایش می‌کند. سبز = دست‌دهی TLS موفق، قرمز = مسدود.</x:String>
  <x:String x:Key="Sni.ModeDomain">آزمایش دامنه‌ها</x:String>
  <x:String x:Key="Sni.ModeRange">اسکن بازه IP</x:String>
  <x:String x:Key="Sni.Domains">دامنه‌های نامزد</x:String>
  <x:String x:Key="Sni.DomainsWatermark">هر خط یک دامنه (مثلاً www.cloudflare.com)</x:String>
  <x:String x:Key="Sni.RangeSni">میزبان SNI</x:String>
  <x:String x:Key="Sni.RangeCidr">بازه IPv4 (CIDR)</x:String>
  <x:String x:Key="Sni.Port">درگاه</x:String>
  <x:String x:Key="Sni.ApplyAsSni">استفاده به‌عنوان میزبان SNI</x:String>
  <x:String x:Key="Sni.Mode">حالت</x:String>
  <x:String x:Key="Sni.CustomSourceHint">جعبه دامنه‌های نامزد را برای وارد کردن فهرست خودتان نشان بده.</x:String>
  <x:String x:Key="Sni.Country">کشور</x:String>
  <x:String x:Key="Sni.RequestSni">درخواست SNI</x:String>
  <x:String x:Key="Sni.Requesting">در حال درخواست فهرست SNI…</x:String>
  <x:String x:Key="Sni.RequestEmpty">هنوز فهرست SNI برای این کشور نیست.</x:String>
  <x:String x:Key="Sni.NoCountries">هنوز فهرست SNI موجود نیست. از بارگذاری نامزدها استفاده کنید.</x:String>
  <x:String x:Key="Sni.LoadCandidates">بارگذاری نامزدها</x:String>
  <x:String x:Key="Sni.CandidatesLoaded">فهرست آغازین نامزدهای SNI بارگذاری شد. اسکن را آغاز کنید.</x:String>
  <x:String x:Key="Sni.ColSni">SNI</x:String>
  <x:String x:Key="Sni.ColIp">IP</x:String>
  <x:String x:Key="Sni.EmptyTitle">هنوز نتیجه‌ای برای SNI نیست</x:String>
  <x:String x:Key="Sni.EmptyDescription">دامنه‌ها (یا یک SNI + بازه IP) را وارد کنید و اسکن را آغاز کنید.</x:String>
  <x:String x:Key="Sni.Ready">آماده.</x:String>
  <x:String x:Key="Sni.NeedDomains">حداقل یک دامنه برای آزمایش وارد کنید.</x:String>
  <x:String x:Key="Sni.NeedSni">یک میزبان SNI برای آزمایش در سراسر بازه وارد کنید.</x:String>
  <x:String x:Key="Sni.NeedCidr">یک بازه معتبر IPv4 CIDR وارد کنید، مثلاً 104.16.0.0/24.</x:String>
  <x:String x:Key="Sni.Scanning">در حال اسکن…</x:String>
  <x:String x:Key="Sni.Done">انجام شد.</x:String>
  <x:String x:Key="Sni.Stopped">اسکن متوقف شد.</x:String>
  <x:String x:Key="Sni.Stopping">در حال توقف…</x:String>
  <x:String x:Key="Sni.Failed">اسکن ناموفق بود</x:String>
  <x:String x:Key="Saved.Title">پل‌ها و SNI ذخیره‌شده</x:String>
  <x:String x:Key="Saved.Subtitle">کتابخانه پل‌ها و میزبان‌های SNI ذخیره‌شده شما. برای استفاده اعمال کنید، یا برچسب‌گذاری و حذف کنید.</x:String>
  <x:String x:Key="Saved.Clear">پاک‌کردن همه</x:String>
  <x:String x:Key="Saved.ColType">نوع</x:String>
  <x:String x:Key="Saved.ColLine">پل / SNI</x:String>
  <x:String x:Key="Saved.ColLabel">برچسب</x:String>
  <x:String x:Key="Saved.ColAdded">افزوده‌شده</x:String>
  <x:String x:Key="Saved.LabelWatermark">برچسب</x:String>
  <x:String x:Key="Saved.Apply">اعمال</x:String>
  <x:String x:Key="Saved.Delete">حذف</x:String>
  <x:String x:Key="Saved.Copy">کپی</x:String>
  <x:String x:Key="Saved.CopyAll">کپی همه</x:String>
  <x:String x:Key="Edit.Cut">برش</x:String>
  <x:String x:Key="Edit.Copy">کپی</x:String>
  <x:String x:Key="Edit.Paste">چسباندن</x:String>
  <x:String x:Key="Edit.Delete">حذف</x:String>
  <x:String x:Key="Edit.SelectAll">انتخاب همه</x:String>
  <x:String x:Key="Saved.EmptyTitle">هنوز چیزی ذخیره نشده</x:String>
  <x:String x:Key="Saved.EmptyDescription">پل‌ها یا میزبان‌های SNI کارآمد اسکنر را ذخیره کنید تا کتابخانه بسازید.</x:String>

  <!-- Home -->
  <x:String x:Key="Home.CurrentIp">IP فعلی</x:String>
  <x:String x:Key="Home.Connect">اتصال</x:String>
  <x:String x:Key="Home.Disconnect">قطع اتصال</x:String>
  <x:String x:Key="Home.Cancel">لغو</x:String>
  <x:String x:Key="Home.RefreshIp">بروزرسانی IP</x:String>
  <x:String x:Key="Home.NewIdentity">هویت جدید</x:String>
  <x:String x:Key="Home.UpdateBridges">بروزرسانی پل‌ها</x:String>
  <x:String x:Key="Home.UpdateBridgesTooltip">دریافت پل‌های تازه و آزمایش‌شده از طریق اتصال معمولی (حتی پشت VPN کار می‌کند). نیازی به اتصال به Tor از قبل نیست.</x:String>
  <x:String x:Key="Home.SystemProxyOn">پروکسی سیستم: روشن</x:String>
  <x:String x:Key="Home.SystemProxyOff">پروکسی سیستم: خاموش</x:String>
  <x:String x:Key="Home.SystemProxyTooltip">تعیین می‌کند که آیا ترافیک سیستم در حالت Proxy از Tor عبور کند. قبل از اتصال تغییر دهید تا رفتار را از قبل تنظیم کنید، یا در حین اتصال برای تغییر زنده بدون قطع Tor. وقتی خاموش است، ترافیک سیستم مستقیم می‌رود (مثلاً VPN جداگانه)؛ برنامه‌هایی که به پورت SOCKS اشاره دارند همچنان از Tor استفاده می‌کنند.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateUnknown">آخرین بروزرسانی داده‌های پل: هنوز بروزرسانی نشده.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateValue">آخرین بروزرسانی داده‌های پل: {0}</x:String>
  <x:String x:Key="Home.SmartConnect">اتصال هوشمند (توصیه‌شده)</x:String>
  <x:String x:Key="Home.SmartConnectHint">به‌طور خودکار بهترین استراتژی اتصال Tor را برای شبکه و پروفایل کشور شما انتخاب می‌کند. وقتی فعال است، تنظیمات پل/سانسور ممکن است نادیده گرفته شوند.</x:String>
  <x:String x:Key="Home.Mode">حالت</x:String>
  <x:String x:Key="Home.ModeProxy">حالت Proxy</x:String>
  <x:String x:Key="Home.ModeTun">حالت TUN/VPN</x:String>
  <x:String x:Key="Home.Automatic">خودکار</x:String>
  <x:String x:Key="Home.ExitLocation">مکان خروجی</x:String>
  <x:String x:Key="Home.DownloadingComponents">در حال دانلود اجزا...</x:String>

  <!-- Logs -->
  <x:String x:Key="Logs.TabApp">برنامه</x:String>
  <x:String x:Key="Logs.TabDns">DNS</x:String>
  <x:String x:Key="Logs.TabXray">Xray</x:String>
  <x:String x:Key="Logs.TabSingBox">Sing-box</x:String>
