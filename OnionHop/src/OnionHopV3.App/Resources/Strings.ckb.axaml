  <!-- Bridge Scanner -->
  <x:String x:Key="Scanner.Title">سکانەری بریج</x:String>
  <x:String x:Key="Scanner.Subtitle">بریجەکان بە TCP-ping تاقی دەکرێنەوە بۆ دۆزینەوەی ئەوانەی لە ناوچەکەتدا دەگەندرێن. سەوز = دەگات، زەرد = هێواش، سوور = گیراو/نادەگات. ئەوانەی کار دەکەن هەڵبژارن یان وەک بریجی تایبەت بەکاربهێنن.</x:String>
  <x:String x:Key="Scanner.Category">پۆل</x:String>
  <x:String x:Key="Scanner.Transport">گواستنەوە</x:String>
  <x:String x:Key="Scanner.IpVersion">IP</x:String>
  <x:String x:Key="Scanner.Workers">کرێکاران</x:String>
  <x:String x:Key="Scanner.Timeout">ماوەی چاوەڕێ (چ)</x:String>
  <x:String x:Key="Scanner.CustomSource">لیستی تایبەت</x:String>
  <x:String x:Key="Scanner.CustomSourceHint">بریجە ئامادەکراوەکانت بسکانە لە جیاتی لیستی کۆلێکتەر.</x:String>
  <x:String x:Key="Scanner.CustomWatermark">ڕیزەکانی بریج لێرە پەیست بکە، یەک بۆ هەر ڕیزێک (بۆ نموونە obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0)</x:String>
  <x:String x:Key="Scanner.Start">سکان دەست پێ بکە</x:String>
  <x:String x:Key="Scanner.Stop">وەستان</x:String>
  <x:String x:Key="Scanner.Export">هەڵبژاردنەکانی کارکردن هەڵبگرە</x:String>
  <x:String x:Key="Scanner.ApplyAsCustom">کارکردنەکان وەک بریج بەکاربهێنە</x:String>
  <x:String x:Key="Scanner.ColType">جۆری بریج</x:String>
  <x:String x:Key="Scanner.ColHost">هۆست</x:String>
  <x:String x:Key="Scanner.ColPort">پۆرت</x:String>
  <x:String x:Key="Scanner.ColPing">پینگ (ms)</x:String>
  <x:String x:Key="Scanner.ColStatus">دۆخ</x:String>
  <x:String x:Key="Scanner.EmptyTitle">هێشتا ئەنجامی سکانێک نییە</x:String>
  <x:String x:Key="Scanner.EmptyDescription">پۆل/گواستنەوەیەک هەڵبژێرە و سکان دەست پێ بکە، یان لیستێکی تایبەت پەیست بکە.</x:String>
  <x:String x:Key="Scanner.TabBridge">سکانەری پرد</x:String>
  <x:String x:Key="Scanner.TabSni">سکانەری SNI</x:String>
  <x:String x:Key="Scanner.TabSaved">پاشەکەوتکراو</x:String>
  <x:String x:Key="Scanner.SaveToLibrary">پاشەکەوت لە کتێبخانە</x:String>
  <x:String x:Key="Scanner.LoadBridges">بارکردنی پردەکان</x:String>
  <x:String x:Key="Scanner.ImportFile">هاوردەکردنی پەڕگە</x:String>
  <x:String x:Key="Sni.Title">سکانەری SNI</x:String>
  <x:String x:Key="Sni.Subtitle">هۆستە SNI/فڕۆنتەکان دەدۆزێتەوە کە لە تۆڕەکەت کاردەکەن. دۆخی دۆمەین لیستێک دۆمەین تاقی دەکاتەوە؛ دۆخی مەودا یەک SNI بەسەر مەودای IPv4 تاقی دەکاتەوە. سەوز = تۆکەڵی TLS سەرکەوتوو، سوور = بلۆککراو.</x:String>
  <x:String x:Key="Sni.ModeDomain">تاقیکردنەوەی دۆمەینەکان</x:String>
  <x:String x:Key="Sni.ModeRange">سکانی مەودای IP</x:String>
  <x:String x:Key="Sni.Domains">دۆمەینە بەربژێرەکان</x:String>
  <x:String x:Key="Sni.DomainsWatermark">هەر دێڕێک یەک دۆمەین (وەک www.cloudflare.com)</x:String>
  <x:String x:Key="Sni.RangeSni">هۆستی SNI</x:String>
  <x:String x:Key="Sni.RangeCidr">مەودای IPv4 (CIDR)</x:String>
  <x:String x:Key="Sni.Port">پۆرت</x:String>
  <x:String x:Key="Sni.ApplyAsSni">وەک هۆستی SNI بەکاربهێنە</x:String>
  <x:String x:Key="Sni.Mode">دۆخ</x:String>
  <x:String x:Key="Sni.CustomSourceHint">سنووقی دۆمەینە بەربژێرەکان پیشان بدە بۆ لکاندنی لیستی خۆت.</x:String>
  <x:String x:Key="Sni.Country">وڵات</x:String>
  <x:String x:Key="Sni.RequestSni">داواکردنی SNI</x:String>
  <x:String x:Key="Sni.Requesting">داوای لیستی SNI دەکرێت…</x:String>
  <x:String x:Key="Sni.RequestEmpty">هێشتا لیستی SNI بۆ ئەم وڵاتە نییە.</x:String>
  <x:String x:Key="Sni.NoCountries">هێشتا لیستی SNI بەردەست نییە. لەبری ئەوە بارکردنی بەربژێرەکان بەکاربهێنە.</x:String>
  <x:String x:Key="Sni.LoadCandidates">بارکردنی بەربژێرەکان</x:String>
  <x:String x:Key="Sni.CandidatesLoaded">لیستێکی سەرەتایی بەربژێری SNI بارکرا. سکان دەست پێبکە.</x:String>
  <x:String x:Key="Sni.ColSni">SNI</x:String>
  <x:String x:Key="Sni.ColIp">IP</x:String>
  <x:String x:Key="Sni.EmptyTitle">هێشتا ئەنجامی SNI نییە</x:String>
  <x:String x:Key="Sni.EmptyDescription">دۆمەینەکان (یان SNI + مەودای IP) بنووسە و سکان دەست پێبکە.</x:String>
  <x:String x:Key="Sni.Ready">ئامادە.</x:String>
  <x:String x:Key="Sni.NeedDomains">بۆ تاقیکردنەوە لانیکەم یەک دۆمەین بنووسە.</x:String>
  <x:String x:Key="Sni.NeedSni">هۆستێکی SNI بنووسە بۆ تاقیکردنەوە بەسەر مەوداکەدا.</x:String>
  <x:String x:Key="Sni.NeedCidr">مەودایەکی دروستی IPv4 CIDR بنووسە، وەک 104.16.0.0/24.</x:String>
  <x:String x:Key="Sni.Scanning">سکان دەکرێت…</x:String>
  <x:String x:Key="Sni.Done">تەواو بوو.</x:String>
  <x:String x:Key="Sni.Stopped">سکان ڕاگیرا.</x:String>
  <x:String x:Key="Sni.Stopping">ڕادەگیرێت…</x:String>
  <x:String x:Key="Sni.Failed">سکان سەرکەوتوو نەبوو</x:String>
  <x:String x:Key="Saved.Title">پردە و SNI پاشەکەوتکراوەکان</x:String>
  <x:String x:Key="Saved.Subtitle">کتێبخانەی پردە و هۆستە SNI پاشەکەوتکراوەکانت. بۆ بەکارهێنان جێبەجێی بکە، یان ناوی بگۆڕە و بیسڕەوە.</x:String>
  <x:String x:Key="Saved.Clear">سڕینەوەی هەموو</x:String>
  <x:String x:Key="Saved.ColType">جۆر</x:String>
  <x:String x:Key="Saved.ColLine">پرد / SNI</x:String>
  <x:String x:Key="Saved.ColLabel">ناونیشان</x:String>
  <x:String x:Key="Saved.ColAdded">زیادکراو</x:String>
  <x:String x:Key="Saved.LabelWatermark">ناونیشان</x:String>
  <x:String x:Key="Saved.Apply">جێبەجێکردن</x:String>
  <x:String x:Key="Saved.Delete">سڕینەوە</x:String>
  <x:String x:Key="Saved.Copy">لەبەرگرتنەوە</x:String>
  <x:String x:Key="Saved.CopyAll">لەبەرگرتنەوەی هەموو</x:String>
  <x:String x:Key="Edit.Cut">بڕین</x:String>
  <x:String x:Key="Edit.Copy">لەبەرگرتنەوە</x:String>
  <x:String x:Key="Edit.Paste">لکاندن</x:String>
  <x:String x:Key="Edit.Delete">سڕینەوە</x:String>
  <x:String x:Key="Edit.SelectAll">هەمووی هەڵبژێرە</x:String>
  <x:String x:Key="Saved.EmptyTitle">هێشتا هیچ پاشەکەوت نەکراوە</x:String>
  <x:String x:Key="Saved.EmptyDescription">پردە یان هۆستە SNI کارکردووەکان لە سکانەرەوە پاشەکەوت بکە بۆ دروستکردنی کتێبخانەکەت.</x:String>

  <!-- Home -->
  <x:String x:Key="Home.CurrentIp">IP-ی ئێستا</x:String>
  <x:String x:Key="Home.Connect">پەیوەندی کردن</x:String>
  <x:String x:Key="Home.Disconnect">قەتاندنەوە</x:String>
  <x:String x:Key="Home.Cancel">هەڵوەشاندنەوە</x:String>
  <x:String x:Key="Home.RefreshIp">نوێکردنەوەی IP</x:String>
  <x:String x:Key="Home.NewIdentity">ناسنامەی نوێ</x:String>
  <x:String x:Key="Home.UpdateBridges">نوێکردنەوەی بریجەکان</x:String>
  <x:String x:Key="Home.UpdateBridgesTooltip">بریجە تازە و تاقیکراوەکان لە ڕێگەی پەیوەندی ئاساییت وەربگرە (لە پشت VPN-یش کار دەکات). پێویست نییە پێشتر بە Tor پەیوەند بیت.</x:String>
  <x:String x:Key="Home.SystemProxyOn">پرۆکسی سیستەم: چالاک</x:String>
  <x:String x:Key="Home.SystemProxyOff">پرۆکسی سیستەم: ناچالاک</x:String>
  <x:String x:Key="Home.SystemProxyTooltip">دیاریدەکات کە ئایا ترافیکی سیستەم لە دۆخی پرۆکسیدا لە ڕێگەی Tor دەچێت. پێش پەیوەندیکردن بگۆڕە بۆ دانانی ڕەفتار، یان لە کاتی پەیوەندیدا بگۆڕە بەبێ قەتاندنی Tor. کاتێک ناچالاکە، ترافیکی سیستەم ڕاستەوخۆ دەچێت (بۆ نموونە VPN-ی جیا)؛ بەرنامەکانی بە پۆرتی SOCKS ئاراستەکراون هێشتا Tor بەکاردەهێنن.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateUnknown">داتای بریج کۆتا جار نوێکراوەتەوە: هێشتا نوێنەکراوەتەوە.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateValue">داتای بریج کۆتا جار نوێکراوەتەوە: {0}</x:String>
  <x:String x:Key="Home.SmartConnect">پەیوەندی زیرەک (پێشنیازکراو)</x:String>
  <x:String x:Key="Home.SmartConnectHint">بە خۆکارانە باشترین ستراتیژی پەیوەندی بۆ Tor بۆ تۆڕ و پرۆفایلی وڵاتەکەت دیاریدەکات. کاتێک چالاکە، ڕێکخستنەکانی بریج/سانسور لەوانەیە بگۆڕدرێن.</x:String>
  <x:String x:Key="Home.Mode">دۆخ</x:String>
  <x:String x:Key="Home.ModeProxy">دۆخی پرۆکسی</x:String>
  <x:String x:Key="Home.ModeTun">دۆخی TUN/VPN</x:String>
  <x:String x:Key="Home.Automatic">بە خۆکارانە</x:String>
  <x:String x:Key="Home.ExitLocation">شوێنی دەرچوون</x:String>
  <x:String x:Key="Home.DownloadingComponents">دابەزاندنی پێکهاتەکان...</x:String>

