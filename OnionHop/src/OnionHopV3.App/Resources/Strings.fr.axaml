  <x:String x:Key="BridgeType.MeekAzure">meek-azure</x:String>
  <x:String x:Key="BridgeType.Dnstt">Tunnel DNS (dnstt)</x:String>
  <x:String x:Key="BridgeType.Custom">personnalisé</x:String>
  <x:String x:Key="BridgeSource.Auto">Auto (collecteur, service de ponts, puis hors ligne)</x:String>
  <x:String x:Key="BridgeSource.OnlineOnly">Service de ponts Tor uniquement</x:String>
  <x:String x:Key="BridgeSource.OfflineOnly">Hors ligne uniquement</x:String>
  <x:String x:Key="BridgeSource.CollectorOnly">Collecteur OnionHop uniquement</x:String>
  <x:String x:Key="BridgeSource.Custom">Liste personnalisée (depuis les réglages)</x:String>
  <x:String x:Key="ProxyScope.System">Proxy système (toutes les applications)</x:String>
  <x:String x:Key="ProxyScope.SystemSocks">Proxy système (navigateur SOCKS/.onion)</x:String>
  <x:String x:Key="ProxyScope.LocalOnly">Proxy local uniquement (applications manuelles)</x:String>
  <x:String x:Key="TunStack.Mixed">Mixte (recommandé)</x:String>
  <x:String x:Key="TunStack.System">Système</x:String>
  <x:String x:Key="TunStack.Gvisor">gVisor</x:String>
  <x:String x:Key="TunCore.SingBox">sing-box (recommandé)</x:String>
  <x:String x:Key="TunCore.Xray">xray (expérimental)</x:String>

