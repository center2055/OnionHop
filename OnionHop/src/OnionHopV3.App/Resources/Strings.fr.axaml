  <!-- Bridge Scanner -->
  <x:String x:Key="Scanner.Title">Scanner de ponts</x:String>
  <x:String x:Key="Scanner.Subtitle">Effectue un ping TCP des ponts pour trouver ceux accessibles depuis votre région. Vert = accessible, orange = lent, rouge = bloqué/inaccessible. Exportez les ponts fonctionnels ou appliquez-les comme ponts personnalisés.</x:String>
  <x:String x:Key="Scanner.Category">Catégorie</x:String>
  <x:String x:Key="Scanner.Transport">Transport</x:String>
  <x:String x:Key="Scanner.IpVersion">IP</x:String>
  <x:String x:Key="Scanner.Workers">Threads</x:String>
  <x:String x:Key="Scanner.Timeout">Délai (s)</x:String>
  <x:String x:Key="Scanner.CustomSource">Liste personnalisée</x:String>
  <x:String x:Key="Scanner.CustomSourceHint">Analysez vos propres lignes de ponts collées au lieu de la liste du collecteur.</x:String>
  <x:String x:Key="Scanner.CustomWatermark">Collez les lignes de ponts ici, une par ligne (ex. obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0)</x:String>
  <x:String x:Key="Scanner.Start">Lancer l'analyse</x:String>
  <x:String x:Key="Scanner.Stop">Arrêter</x:String>
  <x:String x:Key="Scanner.Export">Exporter les fonctionnels</x:String>
  <x:String x:Key="Scanner.ApplyAsCustom">Utiliser les fonctionnels comme ponts</x:String>
  <x:String x:Key="Scanner.ColType">Type de pont</x:String>
  <x:String x:Key="Scanner.ColHost">Hôte</x:String>
  <x:String x:Key="Scanner.ColPort">Port</x:String>
  <x:String x:Key="Scanner.ColPing">Ping (ms)</x:String>
  <x:String x:Key="Scanner.ColStatus">État</x:String>
  <x:String x:Key="Scanner.EmptyTitle">Aucun résultat d'analyse pour l'instant</x:String>
  <x:String x:Key="Scanner.EmptyDescription">Choisissez une catégorie/un transport et appuyez sur Lancer l'analyse, ou collez une liste personnalisée.</x:String>
  <x:String x:Key="Scanner.TabBridge">Scanner de ponts</x:String>
  <x:String x:Key="Scanner.TabSni">Scanner SNI</x:String>
  <x:String x:Key="Scanner.TabSaved">Enregistrés</x:String>
  <x:String x:Key="Scanner.SaveToLibrary">Enregistrer dans la bibliothèque</x:String>
  <x:String x:Key="Scanner.LoadBridges">Charger les ponts</x:String>
  <x:String x:Key="Scanner.ImportFile">Importer un fichier</x:String>
  <x:String x:Key="Sni.Title">Scanner SNI</x:String>
  <x:String x:Key="Sni.Subtitle">Trouve des hôtes SNI/front qui fonctionnent sur votre réseau. Le mode Domaines teste une liste de domaines ; le mode Plage teste un SNI sur une plage IPv4. Vert = handshake TLS réussi, rouge = bloqué.</x:String>
  <x:String x:Key="Sni.ModeDomain">Tester des domaines</x:String>
  <x:String x:Key="Sni.ModeRange">Scanner une plage IP</x:String>
  <x:String x:Key="Sni.Domains">Domaines candidats</x:String>
  <x:String x:Key="Sni.DomainsWatermark">Un domaine par ligne (ex. www.cloudflare.com)</x:String>
  <x:String x:Key="Sni.RangeSni">Hôte SNI</x:String>
  <x:String x:Key="Sni.RangeCidr">Plage IPv4 (CIDR)</x:String>
  <x:String x:Key="Sni.Port">Port</x:String>
  <x:String x:Key="Sni.ApplyAsSni">Utiliser comme hôtes SNI</x:String>
  <x:String x:Key="Sni.Mode">Mode</x:String>
  <x:String x:Key="Sni.CustomSourceHint">Afficher la zone des domaines candidats pour coller votre liste.</x:String>
  <x:String x:Key="Sni.Country">Pays</x:String>
  <x:String x:Key="Sni.RequestSni">Demander un SNI</x:String>
  <x:String x:Key="Sni.Requesting">Demande de la liste SNI…</x:String>
  <x:String x:Key="Sni.RequestEmpty">Aucune liste SNI pour ce pays pour l'instant.</x:String>
  <x:String x:Key="Sni.NoCountries">Aucune liste SNI disponible. Utilisez plutot Charger des candidats.</x:String>
  <x:String x:Key="Sni.LoadCandidates">Charger des candidats</x:String>
  <x:String x:Key="Sni.CandidatesLoaded">Liste de candidats SNI chargee. Lancez le scan.</x:String>
  <x:String x:Key="Sni.ColSni">SNI</x:String>
  <x:String x:Key="Sni.ColIp">IP</x:String>
  <x:String x:Key="Sni.EmptyTitle">Aucun resultat SNI</x:String>
  <x:String x:Key="Sni.EmptyDescription">Saisissez des domaines (ou un SNI + une plage IP) puis lancez le scan.</x:String>
  <x:String x:Key="Sni.Ready">Pret.</x:String>
  <x:String x:Key="Sni.NeedDomains">Saisissez au moins un domaine à tester.</x:String>
  <x:String x:Key="Sni.NeedSni">Saisissez un hôte SNI à tester sur la plage.</x:String>
  <x:String x:Key="Sni.NeedCidr">Saisissez une plage IPv4 CIDR valide, ex. 104.16.0.0/24.</x:String>
  <x:String x:Key="Sni.Scanning">Analyse…</x:String>
  <x:String x:Key="Sni.Done">Termine.</x:String>
  <x:String x:Key="Sni.Stopped">Analyse arretee.</x:String>
  <x:String x:Key="Sni.Stopping">Arret…</x:String>
  <x:String x:Key="Sni.Failed">Échec de l'analyse</x:String>
  <x:String x:Key="Saved.Title">Ponts et SNI enregistrés</x:String>
  <x:String x:Key="Saved.Subtitle">Votre bibliothèque de ponts et d'hôtes SNI enregistrés. Appliquez-en un, ou renommez et supprimez.</x:String>
  <x:String x:Key="Saved.Clear">Tout effacer</x:String>
  <x:String x:Key="Saved.ColType">Type</x:String>
  <x:String x:Key="Saved.ColLine">Pont / SNI</x:String>
  <x:String x:Key="Saved.ColLabel">Etiquette</x:String>
  <x:String x:Key="Saved.ColAdded">Ajoute</x:String>
  <x:String x:Key="Saved.LabelWatermark">etiquette</x:String>
  <x:String x:Key="Saved.Apply">Appliquer</x:String>
  <x:String x:Key="Saved.Delete">Supprimer</x:String>
  <x:String x:Key="Saved.Copy">Copier</x:String>
  <x:String x:Key="Saved.CopyAll">Tout copier</x:String>
  <x:String x:Key="Edit.Cut">Couper</x:String>
  <x:String x:Key="Edit.Copy">Copier</x:String>
  <x:String x:Key="Edit.Paste">Coller</x:String>
  <x:String x:Key="Edit.Delete">Supprimer</x:String>
  <x:String x:Key="Edit.SelectAll">Tout sélectionner</x:String>
  <x:String x:Key="Saved.EmptyTitle">Rien d'enregistré</x:String>
  <x:String x:Key="Saved.EmptyDescription">Enregistrez les ponts ou hôtes SNI fonctionnels du scanner pour constituer votre bibliothèque.</x:String>

  <!-- Home -->
  <x:String x:Key="Home.CurrentIp">IP actuelle</x:String>
  <x:String x:Key="Home.Connect">Se connecter</x:String>
  <x:String x:Key="Home.Disconnect">Se déconnecter</x:String>
  <x:String x:Key="Home.Cancel">Annuler</x:String>
  <x:String x:Key="Home.RefreshIp">Actualiser l'IP</x:String>
  <x:String x:Key="Home.NewIdentity">Nouvelle identité</x:String>
  <x:String x:Key="Home.UpdateBridges">Mettre à jour les ponts</x:String>
  <x:String x:Key="Home.UpdateBridgesTooltip">Récupère des ponts testés récents via votre connexion normale (fonctionne derrière un VPN). Pas besoin d'être connecté à Tor d'abord.</x:String>
  <x:String x:Key="Home.SystemProxyOn">Proxy système : ACTIVÉ</x:String>
  <x:String x:Key="Home.SystemProxyOff">Proxy système : DÉSACTIVÉ</x:String>
  <x:String x:Key="Home.SystemProxyTooltip">Indique si le trafic système passe par Tor en mode proxy. Basculez avant de vous connecter pour prérégler le comportement, ou pendant la connexion pour changer en direct sans déconnecter Tor. Lorsqu'il est désactivé, le trafic système passe en direct (par ex. un VPN distinct) ; les applications dirigées vers le port SOCKS continuent d'utiliser Tor.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateUnknown">dernière mise à jour des données de ponts : pas encore mises à jour.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateValue">dernière mise à jour des données de ponts : {0}</x:String>
  <x:String x:Key="Home.SmartConnect">Connexion intelligente (recommandé)</x:String>
  <x:String x:Key="Home.SmartConnectHint">Choisit automatiquement la meilleure stratégie de connexion Tor pour votre réseau et votre profil de pays. Lorsqu'elle est activée, les paramètres de ponts/censure peuvent être remplacés.</x:String>
  <x:String x:Key="Home.Mode">Mode</x:String>
  <x:String x:Key="Home.ModeProxy">Mode proxy</x:String>
  <x:String x:Key="Home.ModeTun">Mode TUN/VPN</x:String>
  <x:String x:Key="Home.Automatic">Automatique</x:String>
  <x:String x:Key="Home.ExitLocation">Emplacement de sortie</x:String>
  <x:String x:Key="Home.DownloadingComponents">Téléchargement des composants...</x:String>

