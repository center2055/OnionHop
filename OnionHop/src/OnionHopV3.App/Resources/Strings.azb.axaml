  <!-- V3 Status -->
  <x:String x:Key="Status.ProtectionSystem">سیستم-جاپی روتینق فعالدیر</x:String>
  <x:String x:Key="Status.ProtectionProxy">Proxy روتینقی فعالدیر</x:String>
  <x:String x:Key="Status.ProtectionOff">قوروما فعال دئییل</x:String>
  <x:String x:Key="Status.ProtectionOffDetail">ترافیک ایندی عادی شبکه مسیریندن ایستیفاده ائدیر.</x:String>
  <x:String x:Key="Status.EngineClassicDetail">کلاسیک ایجرا بوگون فعالدیر.</x:String>
