  <!-- About -->
  <x:String x:Key="About.Links">Links</x:String>
  <x:String x:Key="About.GitHubIssues">GitHub-Issues</x:String>
  <x:String x:Key="About.Discord">Discord</x:String>
  <x:String x:Key="About.KoFi">Ko-Fi</x:String>
  <x:String x:Key="About.Donate">OnionHop unterst&#252;tzen</x:String>
  <x:String x:Key="About.DonateIntro">OnionHop ist kostenlos und Open Source. Wenn es dir hilft, kannst du die Entwicklung mit Bitcoin unterst&#252;tzen:</x:String>
  <x:String x:Key="About.CopyAddress">Adresse kopieren</x:String>
  <x:String x:Key="About.Copy">Kopieren</x:String>
  <x:String x:Key="About.BridgeSources">Br&#252;ckenquellen</x:String>
  <x:String x:Key="About.BridgeSourcesIntro">Woher OnionHop seine Tor-Br&#252;cken bezieht:</x:String>
  <x:String x:Key="About.CollectorDerived">Unser Collector ist von Delta-Kroneckers Tor-Bridges-Collector abgeleitet (AGPL-3.0):</x:String>
  <x:String x:Key="About.RussiaBridges">Eingebaute Br&#252;cken umfassen auch Listen aus igarecks Projekt vpn-configs-for-russia:</x:String>
  <x:String x:Key="About.FrontedDefaults">Snowflake, meek und conjure nutzen die mit dem Tor Browser gelieferten Standard-Br&#252;ckenzeilen.</x:String>
  <x:String x:Key="About.SniSources">SNI-/Front-Host-Kandidatenlisten, genutzt von der Funktion SNI anfordern des SNI-Scanners:</x:String>
  <x:String x:Key="About.Changelog">Historie von OnionHop</x:String>
  <x:String x:Key="About.Refresh">Aktualisieren</x:String>
  <x:String x:Key="About.ChangelogDetailsExpand">Details +</x:String>
  <x:String x:Key="About.ChangelogViewOnline">Auf GitHub ansehen</x:String>
  <x:String x:Key="About.ChangelogDetailsCollapse">Details -</x:String>
  <x:String x:Key="About.ChangelogLoading">&#196;nderungsverlauf wird von GitHub geladen...</x:String>
  <x:String x:Key="About.ChangelogLoaded">&#196;nderungsverlauf geladen.</x:String>
  <x:String x:Key="About.ChangelogFailed">&#196;nderungsverlauf konnte derzeit nicht geladen werden. Verbindung pr&#252;fen und erneut versuchen.</x:String>
  <x:String x:Key="About.ChangelogEmpty">Keine Release-Eintr&#228;ge gefunden.</x:String>
  <x:String x:Key="About.ChangelogSummaryLoading">Release-Verlauf wird geladen...</x:String>
  <x:String x:Key="About.ChangelogSummaryEmpty">Release-Verlauf ist noch nicht geladen.</x:String>
  <x:String x:Key="About.ChangelogSummaryRange">Zeige {0} Releases von {1} bis {2}.</x:String>
  <x:String x:Key="About.ChangelogTypeRelease">Release</x:String>
  <x:String x:Key="About.ChangelogTypeBeta">Beta / Vorabversion</x:String>
  <x:String x:Key="About.ChangelogDateUnknown">Unbekanntes Datum</x:String>
  <x:String x:Key="About.ChangelogNotesMissing">F&#252;r dieses Release wurden keine &#196;nderungsnotizen bereitgestellt.</x:String>
  <x:String x:Key="About.ProductName">OnionHop V3</x:String>
  <x:String x:Key="About.Tagline">Eine schlanke Desktop-Oberfläche für Tor-Routing, Identitätswechsel und bridge-bewusste Verbindungswahl.</x:String>
  <x:String x:Key="About.ShowHistory">Historie anzeigen</x:String>
  <x:String x:Key="About.HideHistory">Historie ausblenden</x:String>

  <!-- Settings -->
  <x:String x:Key="Settings.TabGeneral">Allgemein</x:String>
  <x:String x:Key="Settings.TabNetwork">Netzwerk</x:String>
  <x:String x:Key="Settings.TabAdvanced">Erweitert</x:String>
  <x:String x:Key="Settings.StartupBehavior">Start &amp; Verhalten</x:String>
  <x:String x:Key="Settings.AutoConnect">Beim Start automatisch verbinden</x:String>
  <x:String x:Key="Settings.AutoStart">Autostart</x:String>
  <x:String x:Key="Settings.AutoStartOff">Aus</x:String>
  <x:String x:Key="Settings.AutoStartOn">Ein</x:String>
  <x:String x:Key="Settings.AutoStartMinimized">Ein (Minimiert)</x:String>
  <x:String x:Key="Settings.MinimizeToTray">Beim Schlie&#223;en ins Tray minimieren</x:String>
  <x:String x:Key="Settings.AutoUpdate">Nach Updates suchen</x:String>
  <x:String x:Key="Settings.Appearance">Darstellung</x:String>
  <x:String x:Key="Settings.AppearanceMode">Designmodus</x:String>
  <x:String x:Key="Settings.AppearanceSystemDefault">Systemstandard</x:String>
  <x:String x:Key="Settings.AppearanceDark">Dunkel</x:String>
  <x:String x:Key="Settings.AppearanceLight">Hell</x:String>
  <x:String x:Key="Settings.NativeChrome">Native Fensterrahmen verwenden (Titelleiste/Buttons)</x:String>
  <x:String x:Key="Settings.Language">Sprache</x:String>
  <x:String x:Key="Settings.ShowAdvancedHomeConnectionDetails">Erweiterte Verbindungsdetails auf der Startseite anzeigen</x:String>
  <x:String x:Key="Settings.ShowAdvancedHomeConnectionDetailsHint">Zeigt aktive SOCKS/HTTP-Ports und den Status des manuellen Exit-Fingerprints auf der Startseite.</x:String>
  <x:String x:Key="Settings.ResetHint">Setzt alle OnionHop V3 Einstellungen auf Standard zur&#252;ck.</x:String>
  <x:String x:Key="Settings.RestoreDefaults">Standards wiederherstellen</x:String>

  <x:String x:Key="Settings.BridgesTitle">Bridges &amp; zensierte Netzwerke</x:String>
  <x:String x:Key="Settings.UseBridges">Tor-Bridges verwenden (obfs4/snowflake/etc)</x:String>
  <x:String x:Key="Settings.BridgeType">Bridge-Typ</x:String>
  <x:String x:Key="Settings.BridgeSource">Bridge-Quelle</x:String>
  <x:String x:Key="Settings.BridgeSourceHint">Auto probiert den OnionHop-Sammler und den Tor-Bridge-Dienst und wechselt sonst auf lokale Offline-Listen. &#8222;Nur OnionHop-Sammler&#8220; holt vorab getestete Br&#252;cken vom Sammler (obfs4, webtunnel, vanilla).</x:String>
  <x:String x:Key="Settings.CustomBridgesWatermark">Bridge-Zeilen von bridges.torproject.org einf&#252;gen...</x:String>
  <x:String x:Key="Settings.CustomSni">Eigene SNI/Front-Hosts (optional)</x:String>
  <x:String x:Key="Settings.CustomSniWatermark">example.com, another.example</x:String>
  <x:String x:Key="Settings.UpstreamProxyTitle">Vorgeschalteter Proxy (erweitert)</x:String>
  <x:String x:Key="Settings.UpstreamProxyHint">Lässt Tor zuerst über einen anderen Proxy nach außen verbinden — nützlich, um OnionHop hinter einem Firmen-/SOCKS-Gateway oder einem Tool wie Proxifier zu betreiben, statt im Netzwerkstack zu kollidieren. Erfordert die Classic-Tor-Engine.</x:String>
  <x:String x:Key="Settings.UpstreamProxyEnable">Vorgeschalteten Proxy verwenden</x:String>
  <x:String x:Key="Settings.UpstreamProxyEnableHint">Den gesamten ausgehenden Tor-Verkehr über den Proxy unten leiten.</x:String>
  <x:String x:Key="Settings.UpstreamProxyHttps">HTTPS-Proxy statt SOCKS5</x:String>
  <x:String x:Key="Settings.UpstreamProxyHttpsHint">Aus = SOCKS5 (am häufigsten). Ein = HTTPS-Proxy (HTTP CONNECT).</x:String>
  <x:String x:Key="Settings.UpstreamProxyHost">Proxy-Host</x:String>
  <x:String x:Key="Settings.UpstreamProxyHostHint">IP oder Hostname des vorgeschalteten Proxys.</x:String>
  <x:String x:Key="Settings.UpstreamProxyPort">Port</x:String>
  <x:String x:Key="Settings.UpstreamProxyUsername">Benutzername (optional)</x:String>
  <x:String x:Key="Settings.UpstreamProxyPassword">Passwort (optional)</x:String>
  <x:String x:Key="Settings.OnionServicesTitle">Onion-Dienste</x:String>
  <x:String x:Key="Settings.OnionServicesHint">Veröffentliche etwas auf diesem Rechner oder in deinem Netzwerk unter einer .onion-Adresse: eine Kamera, ein NAS, eine Web-App. Keine Portfreigabe, keine feste IP und kein DynDNS, und nichts liegt offen im Internet. Adressen werden beim Verbinden vergeben und bleiben danach gleich.</x:String>
  <x:String x:Key="Settings.OnionServicesWarning">Wer die Adresse hat, erreicht das Gerät. Geschützt wird es dann nur noch durch sein eigenes Passwort. Vergib ein starkes und behandle die Adresse wie ein Geheimnis.</x:String>
  <x:String x:Key="Settings.OnionServiceLabelWatermark">Name (z. B. Kamera)</x:String>
  <x:String x:Key="Settings.OnionServiceName">Name</x:String>
  <x:String x:Key="Settings.OnionServiceOnionPort">Onion-Port</x:String>
  <x:String x:Key="Settings.OnionServiceTargetHost">Weiterleiten an Host</x:String>
  <x:String x:Key="Settings.OnionServiceTargetPort">Port</x:String>
  <x:String x:Key="Settings.OnionServiceAdd">Hinzufügen</x:String>
  <x:String x:Key="Settings.OnionServiceNotPublished">Noch nicht veröffentlicht. Verbinde dich, um die Adresse zu erhalten.</x:String>
  <x:String x:Key="Settings.OnionServiceCopied">Adresse in die Zwischenablage kopiert.</x:String>
  <x:String x:Key="Settings.OnionServiceBadOnionPort">Der Onion-Port muss eine Zahl zwischen 1 und 65535 sein.</x:String>
  <x:String x:Key="Settings.OnionServiceBadTargetPort">Der Zielport muss eine Zahl zwischen 1 und 65535 sein.</x:String>
  <x:String x:Key="Settings.OnionServiceAdded">Hinzugefügt. Verbinde dich, um den Dienst zu veröffentlichen und die Adresse zu erhalten.</x:String>
  <x:String x:Key="Settings.OnionServiceRemoved">Entfernt.</x:String>
  <x:String x:Key="Settings.OnionServiceEnabled">Aktiviert. Wird bei der nächsten Verbindung veröffentlicht.</x:String>
  <x:String x:Key="Settings.OnionServiceDisabled">Deaktiviert. Wird nicht veröffentlicht.</x:String>
  <x:String x:Key="Settings.OnionServiceToggle">An/Aus</x:String>
  <x:String x:Key="Settings.SnowflakeAmpHint">Erreicht den Snowflake-Broker über Googles AMP-Cache statt ihn direkt zu kontaktieren. Aktivieren Sie dies, wenn „Snowflake-Broker nicht erreichbar" erscheint — es hilft in Netzwerken, die den Broker blockieren. Betrifft nur den Bridge-Typ Snowflake.</x:String>
  <x:String x:Key="Settings.AppPickerButton">Laufende Apps ausw&#228;hlen…</x:String>
  <x:String x:Key="Settings.AppPickerTitle">Split-Tunneling: Apps ausw&#228;hlen</x:String>
  <x:String x:Key="Settings.AppPickerHint">Das sind die Apps, die du gerade ge&#246;ffnet hast. Lege f&#252;r jede fest, ob sie &#252;ber Tor oder direkt verbindet. Alles auf Standard folgt deiner globalen Hybrid-Einstellung.</x:String>
  <x:String x:Key="Settings.AppPickerRescan">Neu scannen</x:String>
  <x:String x:Key="Settings.AppPickerEmpty">Keine offenen Apps mit Fenster gefunden. Starte zuerst eine App und scanne dann neu.</x:String>
  <x:String x:Key="Settings.AppPickerModeDefault">Standard</x:String>
  <x:String x:Key="Settings.AppPickerModeTor">&#220;ber Tor</x:String>
  <x:String x:Key="Settings.AppPickerModeDirect">Direkt</x:String>
  <x:String x:Key="Settings.AppPickerNone">Keine App-Regeln festgelegt.</x:String>
  <x:String x:Key="Common.Apply">&#220;bernehmen</x:String>
  <x:String x:Key="Common.Cancel">Abbrechen</x:String>
  <x:String x:Key="Settings.SnowflakeAmp">Snowflake: AMP-Cache verwenden (f&#252;r gesperrte Netzwerke)</x:String>
  <x:String x:Key="Settings.ProxyModeTitle">Proxy-Modus</x:String>
  <x:String x:Key="Settings.ProxyScope">Proxy-Verhalten</x:String>
  <x:String x:Key="Settings.ProxyScopeHint">System-Proxy (alle Apps) setzt HTTP/HTTPS + SOCKS. SOCKS Browser/.onion-Modus setzt nur SOCKS f&#252;r bessere .onion-Kompatibilit&#228;t in Browsern. Nur lokal bel&#228;sst die System-Proxy-Einstellungen unver&#228;ndert f&#252;r manuelle App-Konfiguration.</x:String>
  <x:String x:Key="Settings.PreferredSocksPort">Bevorzugter SOCKS-Port</x:String>
  <x:String x:Key="Settings.PreferredHttpPort">Bevorzugter HTTP-Tunnel-Port</x:String>

  <x:String x:Key="Settings.SecureDns">Sicheres DNS (DoH) im VPN-Modus</x:String>
  <x:String x:Key="Settings.DnsProvider">DNS-Anbieter</x:String>
  <x:String x:Key="Settings.DnsProviderHint">Auto testet integrierte DoH-Anbieter und w&#228;hlt den schnellsten erreichbaren. Manuelle Anbieter fallen bei Nichterreichbarkeit automatisch zur&#252;ck.</x:String>
  <x:String x:Key="Settings.CustomDohHost">Eigener DoH-Host / URL</x:String>
  <x:String x:Key="Settings.CustomDohHostWatermark">cloudflare-dns.com oder https://dns.example:443</x:String>
  <x:String x:Key="Settings.CustomDohPath">Eigener DoH-Pfad</x:String>
  <x:String x:Key="Settings.CustomDohPathWatermark">/dns-query</x:String>

  <x:String x:Key="Settings.TorAdvanced">Tor - Erweitert</x:String>
  <x:String x:Key="Settings.AdvancedTunSection">TUN-Engine</x:String>
  <x:String x:Key="Settings.AdvancedTunSectionHint">Gilt nur im TUN/VPN-Modus. Standardwerte nutzen, au&#223;er du brauchst spezielle Kompatibilit&#228;t.</x:String>
  <x:String x:Key="Settings.TunCore">TUN-Core</x:String>
  <x:String x:Key="Settings.TunStack">TUN-Stack</x:String>
  <x:String x:Key="Settings.TunMtu">TUN-MTU (optional)</x:String>
  <x:String x:Key="Settings.TunMtuWatermark">Leer = Standard (automatisch)</x:String>
  <x:String x:Key="Settings.TunStrictRoute">Strikte Route</x:String>
  <x:String x:Key="Settings.TunStrictRouteHint">Wenn aktiviert, bleibt Routing strikt im TUN-Pfad. Nur zur Fehlersuche in schwierigen Netzwerken deaktivieren.</x:String>
  <x:String x:Key="Settings.KillSwitch">Kill-Switch</x:String>
  <x:String x:Key="Settings.KillSwitchHint">Bricht die Verbindung unerwartet ab, wird der gesamte Internetverkehr blockiert, bis du das Internet auf der Startseite freigibst oder dich neu verbindest. So geht nichts über deine echte Verbindung raus. Nur im Voll-Tunnel-Modus (TUN), nicht mit Split-Tunneling.</x:String>
  <x:String x:Key="Settings.TunStackHint">Wie der Tunnel den Datenverkehr verarbeitet. Mixed passt für die meisten Systeme; probiere System oder gVisor nur, wenn Verbindungen unzuverlässig sind.</x:String>
  <x:String x:Key="Settings.RouteAllWebTrafficHint">Im Hybridmodus zusätzlich den Webverkehr (Ports 80 und 443) aller Apps über Tor leiten, nicht nur den der gewählten Apps. Apps auf der Umgehungsliste bleiben direkt.</x:String>
  <x:String x:Key="Settings.TunDisableIpv6">IPv6 im Tunnel deaktivieren</x:String>
  <x:String x:Key="Settings.TunDisableIpv6Hint">Erstellt den Tunnel-Adapter ohne IPv6-Adresse. Aktiviere dies, wenn der Tunnel mit "set ipv6 address" nicht startet. OnionHop versucht es von selbst ohne IPv6 erneut; dies überspringt den fehlgeschlagenen Versuch.</x:String>
  <x:String x:Key="Settings.EntryNode">Einstiegsknoten (optional)</x:String>
  <x:String x:Key="Settings.EntryNodeHint">Einstiegsknoten k&#246;nnen nicht zusammen mit Bridges verwendet werden.</x:String>
  <x:String x:Key="Settings.OptionDefault">Standard</x:String>
  <x:String x:Key="Settings.OptionEnabled">Aktiviert</x:String>
  <x:String x:Key="Settings.OptionDisabled">Deaktiviert</x:String>
  <x:String x:Key="Settings.ConnectionPaddingAuto">Automatisch (empfohlen)</x:String>
  <x:String x:Key="Settings.ConnectionTimeoutSeconds">Verbindungs-Timeout (Sekunden)</x:String>
  <x:String x:Key="Settings.ConnectionTimeoutSecondsHint">Leer lassen f&#252;r OnionHop-Standard, 0 zum Deaktivieren oder 1-3600 f&#252;r ein festes Timeout.</x:String>
  <x:String x:Key="Settings.ManualExitFingerprint">Manueller Exit-Node-Fingerprint</x:String>
  <x:String x:Key="Settings.ManualExitFingerprintWatermark">Optional (z. B. $FINGERPRINT)</x:String>
  <x:String x:Key="Settings.ManualEntryFingerprint">Manueller Guard-Node-Fingerprint</x:String>
  <x:String x:Key="Settings.ManualEntryFingerprintWatermark">Optionaler Guard-Fingerprint (z. B. $FINGERPRINT)</x:String>
  <x:String x:Key="Settings.ManualMiddleFingerprint">Manueller Middle-Node-Fingerprint</x:String>
  <x:String x:Key="Settings.ManualMiddleFingerprintWatermark">Optionaler Middle-Fingerprint (z. B. $FINGERPRINT)</x:String>
  <x:String x:Key="Settings.StrictManualEntryFingerprint">Strikter manueller Guard-Fingerprint (Fehler bei Nichtverf&#252;gbarkeit)</x:String>
  <x:String x:Key="Settings.StrictManualEntryFingerprintHint">Deaktivieren, um auf andere Guards zur&#252;ckzufallen, wenn der gew&#228;hlte Fingerprint nicht verf&#252;gbar ist.</x:String>
  <x:String x:Key="Settings.StrictManualMiddleFingerprint">Strikter manueller Middle-Fingerprint (Fehler bei Nichtverf&#252;gbarkeit)</x:String>
  <x:String x:Key="Settings.StrictManualMiddleFingerprintHint">Deaktivieren, um auf andere Middle-Relays zur&#252;ckzufallen, wenn der gew&#228;hlte Fingerprint nicht verf&#252;gbar ist.</x:String>
  <x:String x:Key="Settings.StrictManualExitFingerprint">Strikter manueller Exit-Fingerprint (Fehler bei Nichtverf&#252;gbarkeit)</x:String>
  <x:String x:Key="Settings.StrictManualExitFingerprintHint">Deaktivieren, um auf andere Exits zur&#252;ckzufallen, wenn der gew&#228;hlte Fingerprint nicht verf&#252;gbar ist.</x:String>

  <x:String x:Key="Settings.SplitTunnelingTitle">Split-Tunneling (Hybridmodus)</x:String>
  <x:String x:Key="Settings.SplitTunnelingHint">Im Hybridmodus legst du fest, welche Apps Tor nutzen und welche direkt verbinden. Nutze dazu unten die Schaltfl&#228;che "Laufende Apps ausw&#228;hlen…".</x:String>
  <x:String x:Key="Settings.RouteAllWebTraffic">Gesamten Web-Traffic (Ports 80/443) &#252;ber Tor leiten</x:String>
  <x:String x:Key="Settings.BlockQuic">QUIC/UDP f&#252;r Tor-Apps blockieren (verhindert Umgehungs-Leaks)</x:String>
  <x:String x:Key="Settings.BlockUdp">UDP-Verkehr blockieren</x:String>

  <x:String x:Key="Settings.AutomationTitle">Automatisierung</x:String>
  <x:String x:Key="Settings.OpenConnectedPage">Seite bei Verbindung &#246;ffnen</x:String>
  <x:String x:Key="Settings.OpenConnectedPageWatermark">https://check.torproject.org/</x:String>
  <x:String x:Key="Settings.OpenDisconnectedPage">Seite bei Trennung &#246;ffnen</x:String>
  <x:String x:Key="Settings.OpenDisconnectedPageWatermark">https://support.torproject.org/</x:String>
  <x:String x:Key="Settings.DiscordStatus">Discord-Status aktivieren</x:String>

  <!-- Bridge type labels -->
  <x:String x:Key="BridgeType.Automatic">Automatisch (empfohlen)</x:String>
  <x:String x:Key="BridgeType.Vanilla">Vanilla-Bridges</x:String>
  <x:String x:Key="BridgeType.Obfs4">obfs4</x:String>
  <x:String x:Key="BridgeType.Snowflake">snowflake</x:String>
  <x:String x:Key="BridgeType.Conjure">conjure</x:String>
  <x:String x:Key="BridgeType.Webtunnel">webtunnel</x:String>
  <x:String x:Key="BridgeType.MeekAzure">meek-azure</x:String>
  <x:String x:Key="BridgeType.Dnstt">DNS-Tunnel (dnstt)</x:String>
  <x:String x:Key="BridgeType.Custom">benutzerdefiniert</x:String>
  <x:String x:Key="BridgeSource.Auto">Auto (Sammler, Bridge-Dienst, dann Offline)</x:String>
  <x:String x:Key="BridgeSource.OnlineOnly">Nur Tor-Bridge-Dienst</x:String>
  <x:String x:Key="BridgeSource.OfflineOnly">Nur Offline</x:String>
  <x:String x:Key="BridgeSource.CollectorOnly">Nur OnionHop-Sammler</x:String>
  <x:String x:Key="BridgeSource.Custom">Eigene Liste (aus den Einstellungen)</x:String>
  <x:String x:Key="ProxyScope.System">System-Proxy (alle Apps)</x:String>
  <x:String x:Key="ProxyScope.SystemSocks">System-Proxy (SOCKS Browser/.onion)</x:String>
  <x:String x:Key="ProxyScope.LocalOnly">Nur lokaler Proxy (manuelle Apps)</x:String>
  <x:String x:Key="TunStack.Mixed">Gemischt (empfohlen)</x:String>
  <x:String x:Key="TunStack.System">System</x:String>
  <x:String x:Key="TunStack.Gvisor">gVisor</x:String>
  <x:String x:Key="TunCore.SingBox">sing-box (empfohlen)</x:String>
  <x:String x:Key="TunCore.Xray">xray (experimentell)</x:String>

