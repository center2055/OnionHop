  <x:String x:Key="Logs.ColumnLevel">Level</x:String>
  <x:String x:Key="Logs.ColumnSource">Quelle</x:String>
  <x:String x:Key="Logs.ColumnMessage">Meldung</x:String>
  <x:String x:Key="Logs.ColumnType">Typ</x:String>
  <x:String x:Key="Logs.ColumnAddress">Adresse</x:String>
  <x:String x:Key="Logs.ColumnDetails">Details</x:String>
