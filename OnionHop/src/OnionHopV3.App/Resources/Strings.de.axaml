  <!-- Bridge Scanner -->
  <x:String x:Key="Scanner.Title">Bridge-Scanner</x:String>
  <x:String x:Key="Scanner.Subtitle">Bridges per TCP-Ping testen, um in deiner Region erreichbare zu finden. Gr&#252;n = erreichbar, Gelb = langsam, Rot = blockiert/nicht erreichbar. Funktionierende exportieren oder als eigene Bridges &#252;bernehmen.</x:String>
  <x:String x:Key="Scanner.Category">Kategorie</x:String>
  <x:String x:Key="Scanner.Transport">Transport</x:String>
  <x:String x:Key="Scanner.IpVersion">IP</x:String>
  <x:String x:Key="Scanner.Workers">Worker</x:String>
  <x:String x:Key="Scanner.Timeout">Timeout (s)</x:String>
  <x:String x:Key="Scanner.CustomSource">Eigene Liste</x:String>
  <x:String x:Key="Scanner.CustomSourceHint">Eigene eingef&#252;gte Bridge-Zeilen statt der Collector-Liste scannen.</x:String>
  <x:String x:Key="Scanner.CustomWatermark">Bridge-Zeilen hier einf&#252;gen, eine pro Zeile (z.&#160;B. obfs4 1.2.3.4:443 FINGERPRINT cert=... iat-mode=0)</x:String>
  <x:String x:Key="Scanner.Start">Scan starten</x:String>
  <x:String x:Key="Scanner.Stop">Stopp</x:String>
  <x:String x:Key="Scanner.Export">Funktionierende exportieren</x:String>
  <x:String x:Key="Scanner.ApplyAsCustom">Als Bridges &#252;bernehmen</x:String>
  <x:String x:Key="Scanner.ColType">Bridge-Typ</x:String>
  <x:String x:Key="Scanner.ColHost">Host</x:String>
  <x:String x:Key="Scanner.ColPort">Port</x:String>
  <x:String x:Key="Scanner.ColPing">Ping (ms)</x:String>
  <x:String x:Key="Scanner.ColStatus">Status</x:String>
  <x:String x:Key="Scanner.EmptyTitle">Noch keine Scan-Ergebnisse</x:String>
  <x:String x:Key="Scanner.EmptyDescription">Kategorie/Transport w&#228;hlen und Scan starten, oder eine eigene Liste einf&#252;gen.</x:String>
  <x:String x:Key="Scanner.TabBridge">Bridge-Scanner</x:String>
  <x:String x:Key="Scanner.TabSni">SNI-Scanner</x:String>
  <x:String x:Key="Scanner.TabSaved">Gespeichert</x:String>
  <x:String x:Key="Scanner.SaveToLibrary">In Bibliothek speichern</x:String>
  <x:String x:Key="Scanner.LoadBridges">Bridges laden</x:String>
  <x:String x:Key="Scanner.ImportFile">Datei importieren</x:String>
  <x:String x:Key="Sni.Title">SNI-Scanner</x:String>
  <x:String x:Key="Sni.Subtitle">Findet SNI-/Front-Hosts, die in deinem Netzwerk funktionieren. Domain-Modus testet eine Liste von Domains; Bereichsmodus testet eine SNI über einen IPv4-Bereich. Grün = TLS-Handshake erfolgreich, rot = blockiert.</x:String>
  <x:String x:Key="Sni.ModeDomain">Domains testen</x:String>
  <x:String x:Key="Sni.ModeRange">IP-Bereich scannen</x:String>
  <x:String x:Key="Sni.Domains">Kandidaten-Domains</x:String>
  <x:String x:Key="Sni.DomainsWatermark">Eine Domain pro Zeile (z. B. www.cloudflare.com)</x:String>
  <x:String x:Key="Sni.RangeSni">SNI-Host</x:String>
  <x:String x:Key="Sni.RangeCidr">IPv4-Bereich (CIDR)</x:String>
  <x:String x:Key="Sni.Port">Port</x:String>
  <x:String x:Key="Sni.ApplyAsSni">Als SNI-Hosts verwenden</x:String>
  <x:String x:Key="Sni.Mode">Modus</x:String>
  <x:String x:Key="Sni.CustomSourceHint">Feld für Kandidaten-Domains anzeigen, um eine eigene Liste einzufügen.</x:String>
  <x:String x:Key="Sni.Country">Land</x:String>
  <x:String x:Key="Sni.RequestSni">SNI anfordern</x:String>
  <x:String x:Key="Sni.Requesting">SNI-Liste wird angefordert…</x:String>
  <x:String x:Key="Sni.RequestEmpty">Für dieses Land gibt es noch keine SNI-Liste.</x:String>
  <x:String x:Key="Sni.NoCountries">Noch keine SNI-Listen verfügbar. Nutze stattdessen Kandidaten laden.</x:String>
  <x:String x:Key="Sni.LoadCandidates">Kandidaten laden</x:String>
  <x:String x:Key="Sni.CandidatesLoaded">Startliste mit SNI-Kandidaten geladen. Scan starten.</x:String>
  <x:String x:Key="Sni.ColSni">SNI</x:String>
  <x:String x:Key="Sni.ColIp">IP</x:String>
  <x:String x:Key="Sni.EmptyTitle">Noch keine SNI-Ergebnisse</x:String>
  <x:String x:Key="Sni.EmptyDescription">Domains (oder SNI + IP-Bereich) eingeben und Scan starten.</x:String>
  <x:String x:Key="Sni.Ready">Bereit.</x:String>
  <x:String x:Key="Sni.NeedDomains">Gib mindestens eine Domain zum Testen ein.</x:String>
  <x:String x:Key="Sni.NeedSni">Gib einen SNI-Host ein, der über den Bereich getestet wird.</x:String>
  <x:String x:Key="Sni.NeedCidr">Gib einen gültigen IPv4-CIDR-Bereich ein, z. B. 104.16.0.0/24.</x:String>
  <x:String x:Key="Sni.Scanning">Wird gescannt…</x:String>
  <x:String x:Key="Sni.Done">Fertig.</x:String>
  <x:String x:Key="Sni.Stopped">Scan gestoppt.</x:String>
  <x:String x:Key="Sni.Stopping">Wird gestoppt…</x:String>
  <x:String x:Key="Sni.Failed">Scan fehlgeschlagen</x:String>
  <x:String x:Key="Saved.Title">Gespeicherte Bridges &amp; SNI</x:String>
  <x:String x:Key="Saved.Subtitle">Deine Bibliothek gespeicherter Bridges und SNI-Hosts. Anwenden zum Verwenden, oder umbenennen und entfernen.</x:String>
  <x:String x:Key="Saved.Clear">Alle löschen</x:String>
  <x:String x:Key="Saved.ColType">Typ</x:String>
  <x:String x:Key="Saved.ColLine">Bridge / SNI</x:String>
  <x:String x:Key="Saved.ColLabel">Bezeichnung</x:String>
  <x:String x:Key="Saved.ColAdded">Hinzugefügt</x:String>
  <x:String x:Key="Saved.LabelWatermark">Bezeichnung</x:String>
  <x:String x:Key="Saved.Apply">Anwenden</x:String>
  <x:String x:Key="Saved.Delete">Löschen</x:String>
  <x:String x:Key="Saved.Copy">Kopieren</x:String>
  <x:String x:Key="Saved.CopyAll">Alle kopieren</x:String>
  <x:String x:Key="Edit.Cut">Ausschneiden</x:String>
  <x:String x:Key="Edit.Copy">Kopieren</x:String>
  <x:String x:Key="Edit.Paste">Einfügen</x:String>
  <x:String x:Key="Edit.Delete">Löschen</x:String>
  <x:String x:Key="Edit.SelectAll">Alles auswählen</x:String>
  <x:String x:Key="Saved.EmptyTitle">Noch nichts gespeichert</x:String>
  <x:String x:Key="Saved.EmptyDescription">Speichere funktionierende Bridges oder SNI-Hosts aus dem Scanner in deiner Bibliothek.</x:String>

  <!-- Home -->
  <x:String x:Key="Home.CurrentIp">Aktuelle IP</x:String>
  <x:String x:Key="Home.Connect">Verbinden</x:String>
  <x:String x:Key="Home.Disconnect">Trennen</x:String>
  <x:String x:Key="Home.Cancel">Abbrechen</x:String>
  <x:String x:Key="Home.RefreshIp">IP aktualisieren</x:String>
  <x:String x:Key="Home.NewIdentity">Neue Identit&#228;t</x:String>
  <x:String x:Key="Home.UpdateBridges">Br&#252;cken aktualisieren</x:String>
  <x:String x:Key="Home.UpdateBridgesTooltip">Frische, getestete Br&#252;cken &#252;ber deine normale Verbindung holen (auch hinter einem VPN). Du musst nicht zuerst mit Tor verbunden sein.</x:String>
  <x:String x:Key="Home.SystemProxyOn">System-Proxy: AN</x:String>
  <x:String x:Key="Home.SystemProxyOff">System-Proxy: AUS</x:String>
  <x:String x:Key="Home.SystemProxyTooltip">Legt fest, ob der System-Verkehr im Proxy-Modus &#252;ber Tor l&#228;uft. Vor dem Verbinden umschalten, um das Verhalten vorab festzulegen, oder w&#228;hrend der Verbindung live umschalten, ohne Tor zu trennen. Bei AUS l&#228;uft der System-Verkehr direkt (z.&#160;B. separates VPN); Apps am SOCKS-Port nutzen weiterhin Tor.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateUnknown">Bridge-Daten zuletzt aktualisiert: noch nicht aktualisiert.</x:String>
  <x:String x:Key="Home.BridgeDataLastUpdateValue">Bridge-Daten zuletzt aktualisiert: {0}</x:String>
  <x:String x:Key="Home.SmartConnect">Smart Connect (empfohlen)</x:String>
  <x:String x:Key="Home.SmartConnectHint">W&#228;hlt automatisch die beste Tor-Verbindungsstrategie f&#252;r dein Netzwerk und L&#228;nderprofil. Wenn aktiviert, k&#246;nnen Bridge-/Zensur-Einstellungen &#252;berschrieben werden.</x:String>
  <x:String x:Key="Home.Mode">Modus</x:String>
  <x:String x:Key="Home.ModeProxy">Proxy-Modus</x:String>
  <x:String x:Key="Home.ModeTun">TUN/VPN-Modus</x:String>
  <x:String x:Key="Home.Automatic">Automatisch</x:String>
  <x:String x:Key="Home.ExitLocation">Austrittsort</x:String>
  <x:String x:Key="Home.DownloadingComponents">Komponenten werden heruntergeladen...</x:String>

